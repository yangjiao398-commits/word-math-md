# Web server
PORT=3010
HOST=0.0.0.0

# Optional Aspose.Words license file path
# ASPOSE_WORDS_LICENSE=./Aspose.Words.lic

# Default conversion options
DEFAULT_IMAGE_DIR=assets
DEFAULT_MATH_FORMAT=latex
DEFAULT_CLEAN_LEVEL=aggressive

# Exam bank (Supabase). Use the service role on this local server only.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PROJECT_REF=
# SUPABASE_ACCESS_TOKEN=   # CLI / 建表用，不要提交到 GitHub

# Optional photographed answer-sheet OCR (vision models beat RapidOCR on handwriting).
# SHEET_OCR_ENGINE=auto
# DASHSCOPE_API_KEY=
# DASHSCOPE_VISION_MODEL=qwen-vl-plus
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# math-agent-app (paid Flutter client)
# APP_PUBLIC_ORIGIN=http://127.0.0.1:3010
# APP_CDN_BASE=https://cdn.example.com
# APP_JWT_SECRET=change-me
# APP_SMS_PROVIDER=dev
# APP_ANDROID_PUSH=getui
# APP_TRIAL_DAYS=7
# APP_PAY_PROVIDER=dev
# 正式收款时改为 live，并填写下方商户参数（华东阿里云/腾讯云均可回调本服务）。
# WECHAT_PAY_APPID=
# WECHAT_PAY_MCHID=
# WECHAT_PAY_SERIAL=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/app/pay/wechat/notify
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
